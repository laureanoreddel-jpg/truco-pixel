{
  "name": "truco-pixel",
  "version": "0.1.0",
  "private": true,
  "description": "Juego de truco argentino simplificado en 2D pixel art",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
